{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {},
  "functions": [],
  "variables": {
    "rulessshName": "in-allow-ssh-admin",
    "rulespriority": "400",
    "sshPort": "22",
    "svctagInternet": "Internet",
    "httpDestip": "10.0.0.4",
    "httpPort": "80",
    "rulehttpName": "in-allow-http-from-internet-to-10.0.0.4",
    "rulehttpPriority": "410"
  },
  "resources": [
    {
      "name": "stneudev100",
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2025-01-01",
      "location": "[resourceGroup().location]",
      "tags": {
        "Environment": "Test"
      },
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      }
    },
    {
      "name": "nsg-neu-dev-web-01",
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-07-01",
      "location": "[resourceGroup().location]",
      "tags": {
        "Environment": "Test"
      },
      "properties": {
        "securityRules": [
          {
            "name": "[variables('rulessshName')]",
            "properties": {
              "description": "[variables('rulessshName')]",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "[variables('sshPort')]",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": "[variables('rulespriority')]",
              "direction": "Inbound"
            }
          },
          {
            "name": "[variables('rulehttpName')]",
            "properties": {
              "description": "[variables('rulehttpName')]",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "[variables('httpPort')]",
              "sourceAddressPrefix": "[variables('svctagInternet')]",
              "destinationAddressPrefix": "[variables('httpDestip')]",
              "access": "Allow",
              "priority": "[variables('rulehttpPriority')]",
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "name": "vnet-neu-dev-01",
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-07-01",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-neu-dev-web-01')]"
      ],
      "tags": {
        "Environment": "Test"
      },
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "snet-neu-dev-web-01",
            "properties": {
              "addressPrefix": "10.0.0.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-neu-dev-web-01')]"
              }
            }
          },
          {
            "name": "snet-neu-dev-web-02",
            "properties": {
              "addressPrefix": "10.0.1.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-neu-dev-web-01')]"
              }
            }
          }
        ]
      }
    },
    {
      "name": "pip-neu-dev-web-01",
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-07-01",
      "location": "[resourceGroup().location]",
      "sku": {
        "name": "Standard"
      },
      "tags": {
        "Environment": "Test"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "name": "nic-neu-dev-web-01",
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-07-01",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'vnet-neu-dev-01')]",
        "[resourceId('Microsoft.Network/publicIPAddresses', 'pip-neu-dev-web-01')]"
      ],
      "tags": {
        "Environment": "Test"
      },
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig-web-01",
            "properties": {
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "10.0.0.4",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'vnet-neu-dev-01', 'snet-neu-dev-web-01')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', 'pip-neu-dev-web-01')]"
              }
            }
          }
        ]
      }
    },
    {
      "name": "vm-neu-dev-web-01",
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-07-01",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', 'stneudev100')]",
        "[resourceId('Microsoft.Network/networkInterfaces', 'nic-neu-dev-web-01')]"
      ],
      "tags": {
        "Environment": "Test"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_D2s_v3"
        },
        "osProfile": {
          "computerName": "vm-neu-dev-web-01",
          "adminUsername": "linuxadmin",
          "adminPassword": "Azure@123"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "name": "osdisk-neu-dev-web-01",
            "caching": "ReadWrite",
            "createOption": "FromImage"
          }
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true,
            "storageUri": "[reference(resourceId('Microsoft.Storage/storageAccounts', 'stneudev100'), '2025-01-01').primaryEndpoints.blob]"
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'nic-neu-dev-web-01')]"
            }
          ]
        }
      }
    }
  ],
  "outputs": {}
}